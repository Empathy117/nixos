#!/usr/bin/env bash
set -euo pipefail

resolve_cli() {
  if [[ -n "${OBSIDIAN_CLI_BIN:-}" ]]; then
    if [[ ! -x "$OBSIDIAN_CLI_BIN" ]]; then
      printf 'OBSIDIAN_CLI_BIN is not executable: %s\n' "$OBSIDIAN_CLI_BIN" >&2
      return 1
    fi
    printf '%s\n' "$OBSIDIAN_CLI_BIN"
    return
  fi

  if command -v obsidian-cli >/dev/null 2>&1; then
    command -v obsidian-cli
    return
  fi

  local app_cli="/Applications/Obsidian.app/Contents/MacOS/obsidian-cli"
  if [[ -x "$app_cli" ]]; then
    printf '%s\n' "$app_cli"
    return
  fi

  local registered_cli="/usr/local/bin/obsidian"
  if [[ -L "$registered_cli" ]]; then
    local target
    target="$(readlink "$registered_cli")"
    if [[ "${target##*/}" == "obsidian-cli" && -x "$registered_cli" ]]; then
      printf '%s\n' "$registered_cli"
      return
    fi
  fi

  printf '%s\n' \
    'Obsidian CLI not found. Refusing to call bare `obsidian`, which may launch the GUI without terminal output.' \
    'Expected `obsidian-cli` on PATH or the CLI binary registered by Obsidian 1.12.7+.' >&2
  return 127
}

cli="$(resolve_cli)"

if [[ "${1:-}" == "--print-binary" ]]; then
  printf '%s\n' "$cli"
  exit 0
fi

exec "$cli" "$@"
